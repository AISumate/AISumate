# Copy to .env and fill in. See DEPLOYMENT.md for the full deploy checklist.
#
# Two kinds of vars below — treat them very differently:
#   - Plain names (TEABLE_*, JWT_SECRET, ...) are read via `process.env` on the
#     server ONLY and must stay secret.
#   - VITE_-prefixed names are bundled into the public client JS by Vite
#     convention — anything here is visible to every site visitor. Only put
#     values here that are SAFE to be public (a referrer-restricted browser
#     API key, a public OAuth client id) — never a real secret.

## Required — without these the site deploys but shows no data.
TEABLE_API_KEY=
TEABLE_API_URL=https://app.teable.ai/api
TEABLE_TABLE_ID=
TEABLE_GITHUB_TABLE_ID=
TEABLE_WEEKLY_VIRAL_GITHUB_TABLE_ID=
TEABLE_LLM_TABLE_ID=
TEABLE_LTD_TABLE_ID=
TEABLE_VIDEO_IMAGE_TABLE_ID=
TEABLE_MUSIC_VOICE_TABLE_ID=
TEABLE_CHATBOTS_TABLE_ID=
TEABLE_FREE_APIS_TABLE_ID=
TEABLE_FREE_LLM_IDE_TABLE_ID=
TEABLE_VIBE_CODING_TABLE_ID=
TEABLE_DESIGNER_TOOLS_TABLE_ID=
TEABLE_AI_INFRA_TABLE_ID=
TEABLE_HARDWARE_TABLE_ID=
TEABLE_TESTING_TOOLS_TABLE_ID=
TEABLE_AI_SECURITY_TABLE_ID=
TEABLE_BUSINESS_PRODUCTIVITY_TABLE_ID=
TEABLE_MCP_PROVIDERS_TABLE_ID=
TEABLE_VPS_CLOUD_TABLE_ID=
TEABLE_AI_MEDIA_TABLE_ID=
TEABLE_AI_INFLUENCERS_TABLE_ID=
TEABLE_AI_SITES_TABLE_ID=
TEABLE_AI_DISCORD_TABLE_ID=
TEABLE_AU_SEO_TOOLS_TABLE_ID=
TEABLE_SUMATE_TOP_RECOMMENDATIONS_TABLE_ID=

## Optional — Manus-era auth/forge integration. Unconfigured outside Manus;
## all public pages work without them (see DEPLOYMENT.md gotchas).
# JWT_SECRET=                  # server-only — session cookie signing, keep secret
# DATABASE_URL=                # server-only
# OAUTH_SERVER_URL=            # server-only, not sensitive (just a URL)
# OWNER_OPEN_ID=                # server-only
# BUILT_IN_FORGE_API_URL=      # server-only
# BUILT_IN_FORGE_API_KEY=      # server-only — keep secret
# VITE_APP_ID=                 # public client id — safe to expose, ships to browser
# VITE_OAUTH_PORTAL_URL=       # public URL — ships to browser
# VITE_FRONTEND_FORGE_API_KEY= # browser key (e.g. referrer-restricted Maps key) — ships to browser
# VITE_FRONTEND_FORGE_API_URL= # public URL — ships to browser
TEABLE_THIS_WEEKS_AI_PICKS_TABLE_ID=
