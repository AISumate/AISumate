# This project is standalone, but it sits under C:\Users\dietg\, which contains a
# pnpm-workspace.yaml. Without this, pnpm walks up, treats the home directory as
# the workspace root, and installs part of the tree into C:\Users\dietg\node_modules.
# TypeScript's typeRoots then walk up into that tree and find a second copy of
# @types/react, producing "ReactNode is not assignable to ReactNode" across the
# codebase while tests and the Vite build still pass.
ignore-workspace=true
